using LibrarySystem.UI;
using MySql.Data.MySqlClient;
using Org.BouncyCastle.Crypto.Generators;

namespace LibrarySystem.Services {
    public class AuthService {
        private readonly string connectionString = "Server=localhost;Database=students;Uid=root;Pwd=SQLAurelio;";

        public UserRecord validateLogin(string studentID, string password) {
            using (MySqlConnection conn = new MySqlConnection(connectionString)) {
                string query = "SELECT MemberID, FullName, Role, PasswordHash FROM Users WHERE StudentID = @StudentID";

                using (MySqlCommand cmd = new MySqlCommand(query, conn)) {
                    cmd.Parameters.AddWithValue("@StudentID", studentID);
                    conn.Open();

                    using (MySqlDataReader reader = cmd.ExecuteReader()) {
                        if (reader.Read()) {
                            string storedHash = reader["PasswordHash"].ToString();

                            if (BCrypt.Verify(password, storedHash)) {
                                return new UserRecord {
                                    MemberID = reader.GetInt32("MemberID"),
                                    FullName = reader["FullName"].ToString(),
                                    Role = reader["Role"].ToString()
                                };
                            }
                        }
                    }
                }
            }

            return null; // no match, or wrong password
        }
    }
}
